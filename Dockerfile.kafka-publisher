FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-api.lock requirements-distributed.lock ./
RUN pip install --no-cache-dir --no-deps -r requirements-api.lock \
    && pip install --no-cache-dir --no-deps -r requirements-distributed.lock \
    && pip install --no-cache-dir setuptools==84.0.0
COPY pyproject.toml README.md ./
COPY requirements-api.txt ./requirements-runtime.txt
COPY src ./src
RUN pip install --no-cache-dir --no-deps --no-build-isolation .

USER 1000:1000
CMD ["python", "-m", "agent_quality_harness.outbox_publisher"]
