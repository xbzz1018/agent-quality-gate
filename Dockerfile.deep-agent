FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-deep-agent.txt ./
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements-deep-agent.txt
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

CMD ["uvicorn", "agent_quality_harness.fake_deep_agent:app", "--host", "0.0.0.0", "--port", "8040"]
