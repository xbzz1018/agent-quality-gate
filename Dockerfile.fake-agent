FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

WORKDIR /app
COPY requirements-fake-http.lock ./
RUN pip install --no-cache-dir --no-deps -r requirements-fake-http.lock
COPY src/agent_quality_harness/fake_http_agent.py ./src/agent_quality_harness/fake_http_agent.py

USER 1000:1000
CMD ["uvicorn", "agent_quality_harness.fake_http_agent:app", "--host", "0.0.0.0", "--port", "8020"]
