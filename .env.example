AQH_ENVIRONMENT=development
AQH_DATABASE_URL=postgresql+psycopg://agent_quality:agent_quality@localhost:5432/agent_quality
AQH_REDIS_URL=redis://localhost:6379/0
AQH_REDIS_QUEUE_KEY=aqh:eval-runs
AQH_REDIS_CLAIM_TIMEOUT_SECONDS=5
AQH_WORKER_LEASE_SECONDS=60
AQH_WORKER_HEARTBEAT_SECONDS=10
AQH_OTEL_ENABLED=false
AQH_OTEL_SERVICE_NAME=agent-quality-harness-api
AQH_OTEL_WORKER_SERVICE_NAME=agent-quality-harness-worker
AQH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
AQH_JAEGER_BASE_URL=http://localhost:16686
# Collector health: http://localhost:13133/; Jaeger admin health: http://localhost:14269/
AQH_DEMO_AGENT_ENDPOINT=http://127.0.0.1:8020/invoke
AQH_DEMO_DATASET_PATH=datasets/demo-fixture-core-v1.json
AQH_INSPECT_LOG_DIR=.tmp/inspect-logs
AQH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
AQH_ACCESS_TOKEN_MINUTES=15
AQH_REFRESH_SESSION_DAYS=7
AQH_REFRESH_COOKIE_SECURE=false
